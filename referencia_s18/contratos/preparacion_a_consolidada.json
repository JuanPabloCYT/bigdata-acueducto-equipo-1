{
  "frontera": "preparacion_a_consolidada",
  "entrada": "datalake/refinada_spark",
  "salida": "datalake/consolidada_elt/consumo_dia_sector",
  "descripcion": "El producto de consumo cuenta todas las lecturas de la preparacion, separa confiables de no confiables y no pierde consumo.",
  "columnas": [
    {"nombre": "fecha", "tipo": "date", "nulable": false},
    {"nombre": "sector", "tipo": "string", "nulable": false},
    {"nombre": "n_lecturas", "tipo": "long", "nulable": false},
    {"nombre": "n_confiables", "tipo": "long", "nulable": false},
    {"nombre": "n_no_confiables", "tipo": "long", "nulable": false},
    {"nombre": "consumo_total_m3", "tipo": "double", "nulable": false, "unidad": "m3"},
    {"nombre": "consumo_confiable_m3", "tipo": "double", "nulable": true, "unidad": "m3"}
  ],
  "grano": ["fecha", "sector"],
  "invariantes": [
    {"id": "PC1", "tipo": "conteo_igual",
     "descripcion": "La suma de n_lecturas es el numero de filas de la preparacion",
     "a": {"tabla": "preparacion", "medida": "filas"}, "b": {"tabla": "producto", "medida": "suma", "columna": "n_lecturas"}},
    {"id": "PC2", "tipo": "unico", "tabla": "producto", "columnas": ["fecha", "sector"],
     "descripcion": "El grano (fecha, sector) no se repite"},
    {"id": "PC3", "tipo": "compuesto", "tabla": "producto", "expresion": "n_confiables + n_no_confiables == n_lecturas",
     "descripcion": "Lo confiable y lo no confiable suman todas las lecturas"},
    {"id": "PC4", "tipo": "sin_nulos", "tabla": "producto", "columnas": ["fecha", "sector", "n_lecturas", "consumo_total_m3"],
     "descripcion": "Sin nulos en el grano ni en las medidas obligatorias"},
    {"id": "PC5", "tipo": "suma_igual", "tolerancia": 1e-6,
     "descripcion": "El consumo total del producto es el de la preparacion",
     "a": {"tabla": "preparacion", "medida": "suma", "columna": "consumo_m3"}, "b": {"tabla": "producto", "medida": "suma", "columna": "consumo_total_m3"}}
  ]
}
